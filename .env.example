# ===========================================
# 元·内阁元系统 环境变量配置
# ===========================================

# ----- AI 模型配置 -----
OPENAI_API_KEY=your_api_key_here
OPENAI_API_BASE=https://api.minimaxi.com/anthropic
LLM_MODEL=MiniMax-M2.1

# ----- 数据库配置 -----
CHECKPOINT_DB_PATH=./checkpoints.db
CAPACITY_INDEX_PATH=./capacities/capacity_index.json
DEPLOYED_DIR=./deployed
MEMORY_DB_PATH=./memory.db
SKILL_MANIFEST_PATH=./skills/manifest.json

# ----- 飞书集成（可选）-----
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret

# ----- 浏览器工具配置 -----
PLAYWRIGHT_BROWSER_PATH=
PLAYWRIGHT_HEADLESS=true

# ----- 桌面工具配置 -----
DESKTOP_SCREENSHOT_DIR=./screenshots

# ----- 开发配置 -----
DEBUG=false
LOG_LEVEL=INFO
